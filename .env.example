# mailpop Environment Configuration

# Input & Output Files
INPUT_CSV=input.csv
OUTPUT_CSV=output/output.csv
CHECKPOINT_FILE=output/checkpoint.json
CACHE_DIR=output/cache

# Crawling Limits
CONCURRENCY=5
MAX_DEPTH=2
MAX_PAGES_PER_SITE=25
MAX_CRAWL_TIME_PER_SITE_MS=60000
PAGE_TIMEOUT_MS=15000

# Browser Settings
HEADLESS=true

# Throttling & Delay
MIN_DELAY_MS=500
MAX_DELAY_MS=2000

# Retry Configuration
MAX_RETRIES=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
